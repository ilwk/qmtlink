# CLI、SDK 和 bridge 共用的访问密钥。
api_key = "由-qmtlink-自动生成"

[server]
# Windows 路径请使用单引号，或将反斜杠写成双反斜杠。
qmt_path = 'C:\miniQMT安装目录\userdata_mini'
account_id = "你的资金账号"
# 0.0.0.0 允许局域网访问，请确认防火墙和 API key 已妥善配置。
host = '0.0.0.0'
port = 8000
# 真实交易保护：保持 false；只有明确改为 true 并使用 --live 才允许下单。
allow_trading = false

[client]
url = 'http://127.0.0.1:8000'
timeout = 30.0
