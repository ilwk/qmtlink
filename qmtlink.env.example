# Copy to an untracked local file and replace every placeholder.
QMTLINK_API_KEY=replace-with-a-random-secret
QMTLINK_QMT_PATH=C:\path\to\miniQMT\userdata_mini
QMTLINK_ACCOUNT_ID=replace-with-your-account-id
QMTLINK_ACCOUNT_TYPE=STOCK
QMTLINK_STRATEGY_NAME=qmtlink

# Real order submission and cancellation remain disabled unless explicitly enabled.
QMTLINK_ALLOW_LIVE_ORDERS=false

# Optional overrides
# QMTLINK_HOST=127.0.0.1
# QMTLINK_PORT=8000
# QMTLINK_SESSION_ID=123456
# QMTLINK_IDEMPOTENCY_DB=C:\path\to\qmtlink\orders.sqlite3
